# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
# The public HTTPS URL of this backend (e.g., https://kyron-production.up.railway.app)
# Required for Vapi to route voice tool callbacks
BACKEND_URL=http://localhost:3001

# Groq (LLM Chat & Triage)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Vapi (Voice AI & Telephony)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
# Optional explicit webhook override if different from BACKEND_URL
VAPI_WEBHOOK_URL=https://your-backend.up.railway.app

# SendGrid (Appointment Confirmation Emails)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=noreply@kyronmedical.com
